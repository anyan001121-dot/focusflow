# Set at most one of these. Neither is required -- with no key set,
# FocusFlow runs on a heuristic "mock" backend so the app is usable
# out of the box (see focusflow/mock_llm.py).

ANTHROPIC_API_KEY=
# FOCUSFLOW_ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
# FOCUSFLOW_OPENAI_MODEL=gpt-4o-mini

# Where the local SQLite file lives. Defaults to ./focusflow.db
# FOCUSFLOW_DB_PATH=focusflow.db
